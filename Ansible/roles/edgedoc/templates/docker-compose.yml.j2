---
# =============================================================================
# Rôle : edgedoc
# Fichier : roles/edgedoc/templates/docker-compose.yml.j2
#
# Objectif :
# - Déployer BookStack + MariaDB via Docker Compose
# - Reproductibilité : images pinées
# - DevSecOps : secrets via Vault
# - Conserver le contrat d'exposition existant (FQDN/port)
# =============================================================================

services:
  # Service : edgedoc (BookStack)
  edgedoc:
    image: "{{ edgedoc_image }}"
    container_name: edgedoc
    restart: unless-stopped
    depends_on:
      - edgedoc-db

    # Contrat conservé : le reverse proxy continue d'appeler host:edgedoc_port
    ports:
      - "{{ edgedoc_port }}:80"

    environment:
      - PUID={{ edgedoc_puid }}
      - PGID={{ edgedoc_pgid }}
      - TZ={{ edgedoc_tz }}
      - APP_URL={{ edgedoc_scheme }}://{{ edgedoc_fqdn }}
      - APP_KEY={{ edgedoc_app_key }}
      - DB_HOST={{ edgedoc_db_host }}
      - DB_PORT={{ edgedoc_db_port }}
      - DB_DATABASE={{ edgedoc_db_name }}
      - DB_USERNAME={{ edgedoc_db_user }}
      - DB_PASSWORD={{ edgedoc_db_password }}

    volumes:
      - "{{ edgedoc_install_dir }}/app-config:/config"

    networks:
      - edgedoc_net

    healthcheck:
      test: ["CMD-SHELL", "php -v >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  # Service : edgedoc-db (MariaDB)
  edgedoc-db:
    image: "{{ mariadb_image }}"
    container_name: edgedoc-db
    restart: unless-stopped

    environment:
      - MARIADB_DATABASE={{ edgedoc_db_name }}
      - MARIADB_USER={{ edgedoc_db_user }}
      - MARIADB_PASSWORD={{ edgedoc_db_password }}

      - MARIADB_ROOT_PASSWORD={{ edgedoc_db_root_password }}

    volumes:
      - "{{ edgedoc_install_dir }}/db-data:/var/lib/mysql"

    networks:
      - edgedoc_net

    # Healthcheck DB : ping MariaDB local
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

networks:
  edgedoc_net:
    driver: bridge
