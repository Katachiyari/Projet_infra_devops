---
# Single source of truth for all Ansible secrets in this repository.
# Copy to Ansible/inventory/group_vars/all.vault.yml then encrypt with ansible-vault.

# Harbor
vault_harbor_admin_password: "CHANGE_ME_HARBOR_ADMIN_PASSWORD"
vault_harbor_username: "gitlab"
vault_harbor_password: "CHANGE_ME_HARBOR_PASSWORD"

# GitLab
vault_gitlab_root_password: "CHANGE_ME_GITLAB_ROOT_PASSWORD"
vault_gitlab_runner_token: "CHANGE_ME_GITLAB_RUNNER_TOKEN"

# Monitoring
vault_grafana_admin_password: "CHANGE_ME_GRAFANA_PASSWORD"
vault_alertmanager_smtp_password: "CHANGE_ME_SMTP_PASSWORD"

# EdgeDoc
vault_edgedoc_db_password: "CHANGE_ME_EDGEDOC_DB_PASSWORD"
vault_edgedoc_db_root_password: "CHANGE_ME_EDGEDOC_DB_ROOT_PASSWORD"
vault_edgedoc_session_secret: "CHANGE_ME_EDGEDOC_SESSION_SECRET"
vault_edgedoc_app_key: "base64:CHANGE_ME_BOOKSTACK_APP_KEY"

# Taiga
vault_taiga_postgres_password: "CHANGE_ME_TAIGA_POSTGRES_PASSWORD"
vault_taiga_secret_key: "CHANGE_ME_TAIGA_SECRET_KEY"
vault_taiga_rabbitmq_erlang_cookie: "CHANGE_ME_TAIGA_ERLANG_COOKIE"
